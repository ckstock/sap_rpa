<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SapWebLauncher</AssemblyName>
    <RootNamespace>SapWebLauncher</RootNamespace>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon />
    <StartupObject />
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="transaction_template.vbs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sapnco">
      <HintPath>D:\RPA\依赖\SapNco\sapnco.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="sapnco_utils">
      <HintPath>D:\RPA\依赖\SapNco\sapnco_utils.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <None Include="D:\RPA\依赖\SapNco\ijwhost.dll" Link="ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="D:\RPA\依赖\SapNco\cpc4n.dll" Link="cpc4n.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyTransactionScripts" AfterTargets="Build">
    <ItemGroup>
      <TransactionFiles Include="$(MSBuildProjectDirectory)\..\transactions\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(TransactionFiles)"
      DestinationFiles="@(TransactionFiles->'$(OutDir)transactions\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTransactionScriptsToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <TransactionFiles Include="$(MSBuildProjectDirectory)\..\transactions\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(TransactionFiles)"
      DestinationFiles="@(TransactionFiles->'$(PublishDir)transactions\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
